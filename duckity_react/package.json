{
  "name": "@duckity/react",
  "version": "1.0.0",
  "description": "A React SDK for Duckity.",
  "homepage": "https://duckity.com/docs/sdks/react",
  "repository": {
    "url": "https://github.com/duckity-com/sdks"
  },
  "type": "module",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublish": "bun run build"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@duckity/js": "^0.2.1",
    "react": "^19.2.8",
    "swr": "^2.5.1"
  }
}