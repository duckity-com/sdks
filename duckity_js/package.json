{
  "name": "@duckity/js",
  "type": "module",
  "version": "0.1.7",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "collaborators": [
    "Rafael Bradley <rafabradleyrb@gmail.com>"
  ],
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "clean:all": "rm -rf dist",
    "clean:types": "rm -rf dist/types",
    "bundle": "rollup --config rollup.config.ts --configPlugin typescript",
    "prepublishOnly": "bun run clean:all && bun run bundle && bun run clean:types"
  },
  "dependencies": {
    "@duckity/wasm": "file:../duckity_wasm/pkg"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/plugin-wasm": "^6.2.2",
    "@types/bun": "latest",
    "rollup": "^4.62.3",
    "rollup-plugin-dts": "^6.4.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}